{
  "name": "@nuxt-layers/profile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nuxt foundation capability for the personal data that describes a person: what is held, who may see it, and how it is anonymised, under the person's control.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nuxt-layers/profile"
  },
  "exports": {
    ".": "./nuxt.config.ts",
    "./contracts": "./contracts/index.ts",
    "./capability": "./capability.json",
    "./presentation": "./presentation/index.ts",
    "./tailwind.css": "./tailwind.css"
  },
  "files": [
    "app",
    "server",
    "modules",
    "shared",
    "contracts",
    "capability.json",
    "tailwind.css",
    "presentation",
    "nuxt.config.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev:prepare": "nuxt prepare",
    "dev": "nuxt dev playground",
    "build:playground": "nuxt build playground",
    "build:minimal-host": "nuxt build examples/minimal-host",
    "smoke:minimal-host": "node examples/minimal-host/smoke.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "test:e2e": "pnpm build:playground && playwright test"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "nuxt": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt-layers/theme-manager": "git+https://github.com/nuxt-layers/theme-manager.git#master",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "h3": "^1.15.11",
    "nuxt": "^4.5.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
